GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/auth/github/callback

# 데모 계정 (심사용, D-002 원클릭 진입)
DEMO_ACCOUNT_EMAIL=demo@neomeo.dev
