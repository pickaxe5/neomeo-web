# 데이터베이스
DATABASE_URL=postgresql+psycopg://neomeo:neomeo@db:5432/neomeo

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
