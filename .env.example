# GitHub OAuth App 클라이언트 ID — 로그인 및 저장소 변경사항 수집 권한에 사용
GITHUB_CLIENT_ID=your_github_client_id

# GitHub OAuth App 클라이언트 시크릿 — 위 OAuth App의 비밀 값
GITHUB_CLIENT_SECRET=your_github_client_secret

# 데이터베이스 접속 URL — 0층 사실·1층 카드·2층 브리핑 저장소
DATABASE_URL=postgresql://user:password@localhost:5432/neomeo

# 세션·토큰 서명용 시크릿 — 충분히 긴 랜덤 문자열 권장
JWT_SECRET=your_jwt_secret

# AI 요약·브리핑 서비스(neomeo-ai)의 엔드포인트 주소
AI_SERVICE_URL=http://localhost:8000
